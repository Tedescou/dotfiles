# --- Dotfiles Configuration Start ---
# Personal GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_rsa_personal
    IdentitiesOnly yes

# Work GitLab
Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/id_rsa_chamba
    IdentitiesOnly yes
# --- Dotfiles Configuration End ---
